# Copy to .env and fill in.

# Host port the container listens on; point your reverse proxy here.
PORT=8080

# Sent to Open Food Facts with every lookup. Format: AppName/Version (contact e-mail)
OFF_USER_AGENT=AreTherePeanuts/1.0 (you@example.com)

# DNS server nginx uses to resolve world.openfoodfacts.org. 127.0.0.11 is Docker's embedded DNS.
# NGINX_RESOLVER=127.0.0.11
