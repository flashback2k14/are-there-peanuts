{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "are-there-peanuts": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "*.wasm",
                "input": "node_modules/zxing-wasm/dist/reader",
                "output": "wasm"
              }
            ],
            "styles": [
              "node_modules/@fontsource/plus-jakarta-sans/latin-400.css",
              "node_modules/@fontsource/plus-jakarta-sans/latin-500.css",
              "node_modules/@fontsource/plus-jakarta-sans/latin-600.css",
              "node_modules/@fontsource/plus-jakarta-sans/latin-700.css",
              "node_modules/@fontsource/plus-jakarta-sans/latin-ext-400.css",
              "node_modules/@fontsource/plus-jakarta-sans/latin-ext-700.css",
              "node_modules/@fontsource/jetbrains-mono/latin-400.css",
              "node_modules/@fontsource/jetbrains-mono/latin-500.css",
              "tokens.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "fonts": true,
                "styles": { "minify": true, "inlineCritical": false }
              },
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "host": "0.0.0.0",
            "ssl": true
          },
          "configurations": {
            "production": {
              "buildTarget": "are-there-peanuts:build:production"
            },
            "development": {
              "buildTarget": "are-there-peanuts:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
